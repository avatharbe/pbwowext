{
    "name": "paybas/pbwowext",
    "type": "phpbb-extension",
    "description": "This extension enhances the pbWoW style",
    "homepage": "https://github.com/avatharbe/pbwowext",
    "version": "3.3.2",
    "time": "2026-09-24",
    "license": "GPL-2.0",
    "authors": [
        {
            "name": "PayBas",
            "role": "previous developer"
        },
        {
            "name": "Sajaki",
            "email": "sajaki@avathar.be",
            "homepage": "https://www.avathar.be",
            "role": "developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "PBWoW 3.3 Extension",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "protocol": "https://",
            "host": "avathar.be",
            "directory": "/versioncheck",
            "filename": "pbwowext.json"
        }
    }
